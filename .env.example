# Copy this file to .env and fill in the values before running docker compose.

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# From https://console.cloud.google.com/ — create OAuth 2.0 credentials,
# add http://localhost:3000/api/auth/callback/google as a redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
